#include <stdio.h>

int main() {
    int n, b[50], r, i, c=0, d;

    printf("Blocks: ");
    scanf("%d",&n);

    printf("Bitmap: ");
    for(i=0;i<n;i++)
        scanf("%d",&b[i]);

    printf("Required: ");
    scanf("%d",&r);

    for(i=0;i<n && c<r;i++)
        if(b[i]==0)
            b[i]=1, c++;

    if(c<r)
        printf("Not enough space");
    else {
        printf("After allocation: ");
        for(i=0;i<n;i++)
            printf("%d ",b[i]);
    }

    printf("\nDeallocate: ");
    scanf("%d",&d);

    if(d>=0 && d<n)
        b[d]=0;

    printf("Final: ");
    for(i=0;i<n;i++)
        printf("%d ",b[i]);

    return 0;
}
