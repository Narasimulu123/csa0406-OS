        printf("Allocation not possible");
        return 0;
    }

    if(m==1){ // Contiguous
        printf("Blocks: ");
        for(i=0;i<f;i++)
            printf("%d ",i);
    }
    else if(m==2){ // Linked
        printf("Blocks: ");
        for(i=0;i<f;i++)
