#include<stdio.h>
#include<stdlib.h>

int main(){
    int a[20],v[20]={0},n,h,i,j,cur,fc=0,ss=0;

    scanf("%d",&n);

    for(i=0;i<n;i++)
        scanf("%d",&a[i]);

    scanf("%d",&h);

    /* FCFS */
    cur=h;

    for(i=0;i<n;i++){
        fc+=abs(cur-a[i]);
        cur=a[i];
    }

    printf("FCFS = %d\n",fc);

    /* SSTF */
    cur=h;

    for(i=0;i<n;i++){
        int p=-1,m=9999;

        for(j=0;j<n;j++)
            if(!v[j] && abs(cur-a[j])<m)
                m=abs(cur-a[j]),p=j;

        v[p]=1;
        ss+=m;
        cur=a[p];
    }

    printf("SSTF = %d",ss);

    return 0;
}
