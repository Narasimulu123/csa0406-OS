#include<stdio.h>
#include<stdlib.h>

int main(){
    int a[20],n,h,i,j,t,look=0,scan=0,cur;

    scanf("%d",&n);

    for(i=0;i<n;i++)
        scanf("%d",&a[i]);

    scanf("%d",&h);

    /* Sort */
    for(i=0;i<n-1;i++)
        for(j=i+1;j<n;j++)
            if(a[i]>a[j])
                t=a[i],a[i]=a[j],a[j]=t;

    /* LOOK */
    cur=h;

    for(i=0;i<n;i++)
        if(a[i]>=h)
            look+=abs(cur-a[i]),cur=a[i];

    for(i=n-1;i>=0;i--)
        if(a[i]<h)
            look+=abs(cur-a[i]),cur=a[i];

    /* C-SCAN */
    cur=h;

    for(i=0;i<n;i++)
        if(a[i]>=h)
            scan+=abs(cur-a[i]),cur=a[i];

    printf("C-SCAN = %d\n",scan);
    printf("LOOK = %d",look);

    return 0;
}
