#include<stdio.h>
#include<stdlib.h>

int main(){
    int a[20],v[20]={0},n,f,r,h,i,j,cur,fc=0,ss=0;

    scanf("%d%d",&n,&f);

    printf("Allocated: ");

    for(i=0;i<f;i++)
        printf("%d ",i);

    scanf("%d",&r);

    for(i=0;i<r;i++)
        scanf("%d",&a[i]);

    scanf("%d",&h);

    /* FCFS */
    cur=h;

    for(i=0;i<r;i++)
        fc+=abs(cur-a[i]),cur=a[i];

    /* SSTF */
    cur=h;

    for(i=0;i<r;i++){
        int p=-1,m=9999;

        for(j=0;j<r;j++)
            if(!v[j]&&abs(cur-a[j])<m)
                m=abs(cur-a[j]),p=j;

        v[p]=1;
        ss+=m;
        cur=a[p];
    }

    printf("\nFCFS=%d\nSSTF=%d",fc,ss);
    printf("\nBest=%s",fc<ss?"FCFS":"SSTF");

    return 0;
}
